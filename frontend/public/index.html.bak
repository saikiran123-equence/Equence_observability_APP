<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Observability Dashboard</title>
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
  <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-search@0.13.0/lib/xterm-addon-search.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-webgl@0.16.0/lib/xterm-addon-webgl.js"></script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/lucide@0.462.0/dist/umd/lucide.min.js"></script>

  <style>
/* 
 * PREMIUM MODERN-DARK DESIGN SYSTEM 
 * High-fidelity theme with subtle glassmorphism and motion.
 */
:root {
  --bg-primary: #0a0c10;
  --bg-secondary: #0d1117;
  --bg-surface: #161b22;
  --bg-surface-glass: rgba(22, 27, 34, 0.7);
  
  --accent: #58a6ff;
  --accent-secondary: #3fb950;
  --accent-gradient: linear-gradient(135deg, #3a8dff 0%, #00d4ff 100%);
  --accent-glow: rgba(58, 141, 255, 0.4);
  
  --text-main: #e6edf3;
  --text-dim: #8b949e;
  --text-muted: #6e7681;
  
  --border: #30363d;
  --border-light: rgba(255, 255, 255, 0.08);
  
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 20px;
  
  --shadow-sm: 0 4px 12px rgba(0,0,0,0.3);
  --shadow-lg: 0 12px 32px rgba(0,0,0,0.5);
  
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
  
  --sidebar-w: 280px;
  --topbar-h: 72px;
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }

body {
  background-color: var(--bg-primary);
  color: var(--text-main);
  font-family: var(--font-sans);
  height: 100vh;
  display: flex;
  overflow: hidden;
  line-height: 1.5;
}

/* Custom Scrollbar */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }

/* Layout Structure */
#app-container { display: none; width: 100%; height: 100%; }
#app-container.visible { display: flex; animation: fadeIn 0.5s ease-out; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

/* Sidebar Component */
.sidebar {
  width: var(--sidebar-w);
  background: var(--bg-secondary);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  z-index: 10;
}

.sidebar-header {
  height: var(--topbar-h);
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  font-size: 1.2rem;
  letter-spacing: -0.02em;
  background: rgba(13, 17, 23, 0.8);
  backdrop-filter: blur(10px);
}
.sidebar-header i { color: var(--accent); filter: drop-shadow(0 0 8px var(--accent-glow)); }

.server-list { flex: 1; overflow-y: auto; padding: 16px; }

.server-group { margin-bottom: 20px; }
.server-group-header {
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  color: var(--text-dim);
  font-size: 0.75rem;
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 0.08em;
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}
.server-group-header:hover { color: var(--text-main); background: var(--border-light); }
.chevron-icon { margin-left: auto; transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1); opacity: 0.4; }
.server-group.open .chevron-icon { transform: rotate(90deg); opacity: 1; }
.server-group-content { display: none; margin-top: 6px; }
.server-group.open .server-group-content { display: block; animation: slideDown 0.3s ease-out; }

@keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

.server-item {
  padding: 10px 16px;
  margin-bottom: 4px;
  border-radius: var(--radius-md);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid transparent;
}
.server-item:hover { background: var(--border-light); transform: translateX(4px); }
.server-item.active {
  background: var(--accent-gradient);
  color: #fff;
  box-shadow: 0 4px 15px var(--accent-glow);
  border-color: rgba(255,255,255,0.1);
}
.server-item.active .server-name, .server-item.active .server-ip { color: #fff; }
.server-item.active .status-indicator { background: #fff; box-shadow: 0 0 10px #fff; }

.server-info { flex: 1; min-width: 0; }
.server-name { font-size: 0.875rem; font-weight: 600; display: block; }
.server-ip { font-size: 0.7rem; color: var(--text-dim); font-family: var(--font-mono); }
.status-indicator { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-secondary); flex-shrink: 0; }

/* Main Content Area */
.main-area { flex: 1; display: flex; flex-direction: column; min-width: 0; }

.topbar {
  height: var(--topbar-h);
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.current-server-info { display: flex; align-items: center; gap: 16px; }
.server-icon-glow {
  width: 44px; height: 44px; border-radius: 12px; background: var(--bg-surface);
  display: flex; align-items: center; justify-content: center; color: var(--accent);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}
.current-server-title { font-size: 1.125rem; font-weight: 700; color: #fff; letter-spacing: -0.01em; }

.dashboard-content { flex: 1; display: flex; gap: 24px; padding: 24px; overflow: hidden; }

/* Terminal Container */
.terminal-container-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  position: relative;
}

.terminal-header {
  height: 52px;
  background: rgba(22, 27, 34, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 20px;
  gap: 12px;
}
.mac-dots { display: flex; gap: 8px; }
.mac-dot { width: 12px; height: 12px; border-radius: 50%; }
.mac-dot.red { background: #ff5f56; }
.mac-dot.yellow { background: #ffbd2e; }
.mac-dot.green { background: #27c93f; }

.terminal-body { flex: 1; position: relative; padding: 8px; background: #000; }
#terminal { height: 100%; }

/* UI Overlay States */
.overlay {
  position: absolute; inset: 0; background: rgba(13, 17, 23, 0.85);
  backdrop-filter: blur(20px); z-index: 100;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.4s;
}
.overlay.active { opacity: 1; pointer-events: auto; }

/* Modals */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.85);
  backdrop-filter: blur(10px); z-index: 1000;
  display: none; align-items: center; justify-content: center;
}
.modal-content {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 40px;
  width: 100%;
  max-width: 480px;
  box-shadow: var(--shadow-lg);
  animation: modalScale 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}
.modal-content.large { max-width: 900px; max-height: 90vh; overflow-y: auto; }

@keyframes modalScale { from { opacity: 0; transform: scale(0.9) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }

/* Inputs & Buttons */
.input-group { margin-bottom: 24px; }
.input-group label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-dim); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em; }
.input-group input, .input-group select, .filter-input {
  width: 100%; background: var(--bg-primary); border: 1px solid var(--border); color: #fff;
  padding: 12px 16px; border-radius: var(--radius-md); font-family: var(--font-sans); outline: none;
  transition: all 0.2s;
}
.input-group input:focus, .filter-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

.btn-primary {
  background: var(--accent-gradient); color: #fff; border: none; padding: 14px;
  border-radius: var(--radius-md); font-weight: 700; font-size: 0.95rem; cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px var(--accent-glow); }

.btn-glass {
  background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: #fff;
  padding: 10px 20px; border-radius: var(--radius-md); font-weight: 600; cursor: pointer;
  display: flex; align-items: center; gap: 8px; transition: all 0.2s;
}
.btn-glass:hover { background: rgba(255,255,255,0.1); border-color: var(--text-dim); }

/* Metrics */
.metrics-ribbon { width: 300px; display: flex; flex-direction: column; gap: 20px; flex-shrink: 0; }
.metric-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm); }
.metric-label { font-size: 0.8rem; font-weight: 700; color: var(--text-dim); text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
.metric-label i { color: var(--accent); }
.metric-grid .mv { font-size: 1.75rem; font-weight: 800; color: #fff; letter-spacing: -0.02em; }

/* Admin Table */
.admin-table { width: 100%; border-collapse: separate; border-spacing: 0; margin-top: 24px; }
.admin-table th { text-align: left; padding: 16px; color: var(--text-dim); font-size: 0.75rem; text-transform: uppercase; border-bottom: 1px solid var(--border); }
.admin-table td { padding: 16px; border-bottom: 1px solid var(--border); font-size: 0.9rem; }

/* Utility Classes */
.hidden { display: none !important; }
i[data-lucide] { width: 20px; height: 20px; stroke-width: 2.5; }
  </style>

</head>
<body>


  <!-- Login Modal -->
  <div class="modal-overlay" id="loginModal">
    <div class="modal-content">
      <div style="text-align: center; margin-bottom: 28px;">
        <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #868CFF 0%, #4318FF 100%); border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; box-shadow: 0 4px 20px rgba(67,24,255,0.3);"><i data-lucide="shield-check" width="22" height="22" style="color: #fff;"></i></div>
        <h2 style="color: #fff; font-family: var(--font-sans); font-weight: 800; font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: 6px;">Welcome Back</h2>
        <p style="color: #A0AEC0; font-size: 0.8rem; font-weight: 500;">Enter your credentials to access the dashboard</p>
      </div>
      <div class="input-group">
        <label>Username</label>
        <input type="text" id="loginUsername" placeholder="Your username" autocomplete="username">
      </div>
      <div class="input-group">
        <label>Password</label>
        <input type="password" id="loginPassword" placeholder="Your password" autocomplete="current-password" onkeydown="if(event.key === 'Enter') doLogin()">
      </div>
      <button class="btn-primary" onclick="doLogin()">SIGN IN</button>
      <div class="error-msg" id="loginError" style="margin-top: 14px; text-align: center; color: #E31A1A; font-size: 0.8rem;"></div>
    </div>
  </div>

  <!-- Invite Accept Modal -->
  <div class="modal-overlay" id="inviteModal">
    <div class="modal-content">
      <h2 class="modal-title">Accept Invitation</h2>
      <p style="text-align:center; color:var(--wp-text-secondary); margin-bottom: 24px; font-weight: 500;">Welcome, <span id="inviteUsername" style="color:var(--accent); font-weight:700;"></span>!</p>
      <div class="input-group">
        <label>Set New Password</label>
        <input type="password" id="invitePassword" placeholder="Minimum 6 characters">
      </div>
      <button class="btn-primary" onclick="acceptInvite()">Create Account</button>
      <div class="error-msg" id="inviteError"></div>
    </div>
  </div>

  <!-- Admin Panel Modal -->
  <div class="modal-overlay" id="adminModal">
    <div class="modal-content large">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
        <h2 class="modal-title" style="margin:0;">User Management</h2>
        <button class="btn-secondary" onclick="document.getElementById('adminModal').style.display='none'">Close</button>
      </div>
      
      <div style="display:flex; gap: 20px; margin-bottom: 24px;">
        <div style="flex: 1; background: var(--wp-input-bg); padding: 24px; border-radius: 16px; border: 1px solid var(--wp-border);">
          <h3 style="margin-bottom: 12px; font-size: 1.1rem;">Create User</h3>
          <div class="input-group">
            <label>Username</label>
            <input type="text" id="newUsername" placeholder="e.g. jdoe">
          </div>
          <div class="input-group">
            <label>Group</label>
            <select id="newGroup">
              <option value="Developers">Developers</option>
              <option value="Support">Support</option>
              <option value="Testing">Testing</option>
              <option value="ITinfra">ITinfra (Admin)</option>
            </select>
          </div>
          <div class="input-group">
            <label>Assigned Servers (Comma-separated IDs)</label>
            <input type="text" id="newServers" placeholder="e.g. BLUTO-7, VESTA-241">
          </div>
          <button class="btn-secondary" style="width:100%" onclick="createUser()">Generate Invite</button>
          <div class="success-msg" id="adminSuccess"></div>
          <div class="error-msg" id="adminError"></div>
        </div>
      </div>

      <h3 style="margin-bottom: 12px; font-size: 1.1rem;">Existing Users</h3>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Group</th>
            <th>Status</th>
            <th>Servers</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="usersTableBody"></tbody>
      </table>
    </div>
  </div>

  <div class="modal-overlay" id="logBrowserModal" style="display: none;">
    <div class="modal-content" style="max-width: 600px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
        <h2 class="modal-title" style="margin:0;"><i data-lucide="folder-search" width="20" height="20" style="margin-right: 8px;"></i>Browse Server Logs</h2>
        <button class="btn-secondary" onclick="document.getElementById('logBrowserModal').style.display='none'">Close</button>
      </div>
      <input type="text" id="logSearchInput" class="filter-input" placeholder="Search by name, extension, or path..." style="width: 100%; margin-bottom: 20px; padding: 12px 18px; font-size: 1rem; background: var(--wp-input-bg); border: 1.5px solid var(--wp-border); color: var(--wp-text-primary);">
      <div id="logBrowserList" style="background: var(--wp-input-bg); border-radius: 16px; border: 1.5px solid var(--wp-border); max-height: 400px; overflow-y: auto;">
        <!-- Log items injected here -->
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="downloadModal" style="display: none;">
    <div class="modal-content" style="max-width: 500px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
        <h2 class="modal-title" style="margin:0;"><i data-lucide="download-cloud" width="20" height="20" style="margin-right: 8px;"></i>Download Log Archive</h2>
        <button class="btn-secondary" onclick="document.getElementById('downloadModal').style.display='none'">Close</button>
      </div>
      <p style="font-size: 0.85rem; color: var(--wp-text-secondary); margin-bottom: 24px;">Find and download specific log files. Enter a directory to search by date, or a direct file path to fetch it immediately.</p>
      
      <div class="input-group">
        <label>Select Server</label>
        <select id="downloadServerSelect" class="filter-input" style="width: 100%; background-color: var(--wp-input-bg); color: var(--wp-text-primary); border: 1.5px solid var(--wp-border);"></select>
      </div>
      
      <div class="input-group">
        <label>Search Path</label>
        <div style="display: grid; grid-template-columns: 1fr 140px; gap: 10px;">
          <input type="text" id="downloadPath" class="filter-input" value="/var/log" placeholder="/var/log or /opt/logs" style="background-color: var(--wp-input-bg); color: var(--wp-text-primary); border: 1.5px solid var(--wp-border);">
          <select class="filter-input" onchange="if(this.value){document.getElementById('downloadPath').value=this.value; this.selectedIndex=0;}" style="background-color: var(--wp-input-bg); color: var(--wp-text-primary); border: 1.5px solid var(--wp-border);">
            <option value="" disabled selected>Presets</option>
            <option value="/var/log">System Logs</option>
            <option value="/opt">Apps (/opt)</option>
            <option value="/var/log/nginx">Nginx</option>
            <option value="/var/log/apache2">Apache</option>
            <option value="/var/log/mysql">MySQL</option>
            <option value="/opt/tomcat/logs">Tomcat</option>
            <option value="/">Root (/)</option>
          </select>
        </div>
      </div>
      
      <div style="display: flex; gap: 12px; width: 100%;">
        <div class="input-group" style="flex: 1;">
          <label>Start Date</label>
          <input type="date" id="downloadStartDate" class="filter-input" style="width: 100%; background-color: var(--wp-input-bg); color: var(--wp-text-primary); border: 1.5px solid var(--wp-border);">
        </div>
        <div class="input-group" style="flex: 1;">
          <label>End Date</label>
          <input type="date" id="downloadEndDate" class="filter-input" style="width: 100%; background-color: var(--wp-input-bg); color: var(--wp-text-primary); border: 1.5px solid var(--wp-border);">
        </div>
      </div>
      
      <div id="downloadFileListContainer" style="display: none; margin-top: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label style="font-size: 0.75rem; font-weight: 700; color: var(--wp-text-secondary); text-transform: uppercase;">Select Files to Download</label>
          <div style="display: flex; gap: 8px;">
            <button class="btn-secondary" style="padding: 4px 10px; font-size: 0.7rem;" onclick="toggleAllLogs(true)">Select All</button>
            <button class="btn-secondary" style="padding: 4px 10px; font-size: 0.7rem;" onclick="toggleAllLogs(false)">None</button>
          </div>
        </div>
        <div id="downloadFileList" style="background: var(--wp-input-bg); border-radius: 12px; border: 1.5px solid var(--wp-border); max-height: 200px; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px;"></div>
      </div>
      
      <button class="btn-primary" id="searchLogsBtn" onclick="searchLogsForDownload()" style="margin-top: 24px;">Search Logs</button>
      <button class="btn-primary" id="downloadBtn" onclick="doDownload()" style="margin-top: 24px; display: none; background: linear-gradient(135deg, #01B574 0%, #01E08F 100%);">Download Selected (0)</button>
      <div id="downloadStatus" style="margin-top: 16px; font-size: 0.85rem; text-align: center; font-weight: 600; color: var(--wp-text-primary);"></div>
    </div>
  </div>

  <div id="app-container">
    <aside class="sidebar">
      <div class="sidebar-header">
        <i data-lucide="activity" width="24" height="24"></i>
        <span>Equence ITinfra</span>
      </div>
      <div class="server-list" id="serverList"></div>
      <div style="padding: 20px 16px; border-top: 1px solid var(--wp-border); margin-top: auto;">
        <div class="server-item" onclick="openDownloadModal()" style="background: linear-gradient(135deg, rgba(0, 117, 255, 0.1) 0%, rgba(33, 212, 253, 0.1) 100%); border: 1px solid rgba(0, 117, 255, 0.3); margin-bottom: 0;">
          <div class="server-icon-glow" style="width: 34px; height: 34px; background: linear-gradient(135deg, #0075FF 0%, #21D4FD 100%);">
            <i data-lucide="download-cloud" width="16" height="16" style="color: #fff; filter: drop-shadow(0 0 4px rgba(255,255,255,0.5));"></i>
          </div>
          <div class="server-info">
            <div class="server-name" style="font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.02em;">Download Logs</div>
          </div>
        </div>
      </div>
    </aside>

      <main class="main-area">
      <header class="topbar">
        <div class="topbar-left">
          <div class="current-server-info" id="topbarInfo" style="display: none;">
            <div class="server-icon-glow">
              <i data-lucide="server" width="16" height="16"></i>
            </div>
            <div style="display: flex; flex-direction: column; gap: 1px; min-width: 0;">
              <div class="current-server-title" id="serverTitle">--</div>
              <div class="current-server-subtitle" id="serverIp">--</div>
            </div>
          </div>
          <div class="current-server-info" id="topbarEmpty">
            <div class="server-icon-glow" style="opacity: 0.5;"><i data-lucide="layout-grid" width="16" height="16"></i></div>
            <span class="current-server-title" style="color: var(--wp-text-secondary); font-weight: 500;">Select a server</span>
          </div>
          <span class="greeting-inline" id="userInfo">—</span>
        </div>

        <div style="display: flex; gap: 8px; align-items: center; flex-shrink: 0; flex-wrap: wrap;">
          <button class="btn-glass" id="adminBtn" style="display:none;" onclick="openAdminPanel()" title="User management">
            <i data-lucide="users" width="16" height="16"></i><span class="btn-text">Admin</span>
          </button>
          <button class="btn-glass" onclick="openFind()" title="Find in terminal">
            <i data-lucide="search" width="16" height="16"></i><span class="btn-text">Find</span>
          </button>
          <button class="btn-glass" onclick="toggleTheme()" id="themeBtn" title="Toggle theme">
            <span id="themeIconWrap"><i data-lucide="sun" width="16" height="16"></i></span><span class="btn-text">Theme</span>
          </button>
          <button class="btn-glass" onclick="logout()">
            <i data-lucide="log-out" width="16" height="16"></i><span class="btn-text">Logout</span>
          </button>
        </div>
      </header>

      <div class="dashboard-content">
        <!-- Main Content Area: Terminal -->
        <div class="terminal-container-card" style="flex: 1; display: flex; flex-direction: column; min-width: 0;">
          <div class="log-actions-toolbar" id="logActions">
            <div class="log-toolbar-row paths">
              <button type="button" class="btn-macro neutral" onclick="openLogBrowser()"><i data-lucide="folder-search" width="14" height="14"></i> Browse</button>
              <input type="text" id="logPathInput" class="filter-input input-chip" value="/var/log/messages" title="Log file path" autocomplete="off" spellcheck="false">
              <input type="text" id="liveGrepInput" class="filter-input" placeholder="Filter (grep)…" title="Applied to tail / journalctl" autocomplete="off" spellcheck="false">
              <button type="button" class="btn-macro primary" onclick="executeMacro('grep')" title="Search in file"><i data-lucide="search" width="14" height="14"></i></button>
            </div>
            <div class="log-toolbar-row tools">
              <button type="button" class="btn-macro primary" onclick="executeMacro('tail')"><i data-lucide="file-text" width="14" height="14"></i> Tail</button>
              <button type="button" class="btn-macro error" onclick="executeMacro('error')"><i data-lucide="alert-circle" width="14" height="14"></i> Errors</button>
              <button type="button" class="btn-macro neutral" onclick="executeMacro('clear')"><i data-lucide="eraser" width="14" height="14"></i> Clear</button>
              <div class="journal-box">
                <span class="label">journalctl</span>
                <input type="text" id="journalServiceInput" class="filter-input" list="journalServices" placeholder="nginx.service" autocomplete="off" spellcheck="false">
                <datalist id="journalServices"></datalist>
                <button type="button" class="btn-macro primary" onclick="executeMacro('journal')">Follow</button>
              </div>
            </div>
          </div>

          <div class="terminal-wrapper" style="position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column;">
            <div class="search-overlay" id="searchOverlay" style="background: var(--wp-surface); border: 1px solid var(--wp-border); box-shadow: var(--wp-shadow); z-index: 100;">
              <i data-lucide="search" width="16" height="16" style="color: var(--wp-text-secondary); margin-right: 8px;"></i>
              <input type="text" id="searchInput" placeholder="Find in output..." style="color: var(--wp-text-primary);">
              <button id="searchBtnPrev"><i data-lucide="chevron-up" width="14" height="14"></i></button>
              <button id="searchBtnNext"><i data-lucide="chevron-down" width="14" height="14"></i></button>
              <button onclick="document.getElementById('searchOverlay').style.display = 'none'; searchAddon.clearDecorations();"><i data-lucide="x" width="16" height="16"></i></button>
            </div>

            <div class="empty-state" id="emptyState">
              <div style="width: 72px; height: 72px; background: var(--accent-muted); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <i data-lucide="terminal" width="32" height="32" style="color: var(--accent);"></i>
              </div>
              <h2 style="font-size: 1.15rem; font-weight: 650; color: var(--wp-text-primary); margin-bottom: 8px;">No server selected</h2>
              <p style="font-size: 0.875rem; max-width: 280px; color: var(--wp-text-secondary); line-height: 1.45;">Choose a host in the sidebar to open a session.</p>
            </div>

            <div class="terminal-window" id="terminalWindow" style="display: none; flex: 1; min-height: 0;">
              <div class="terminal-header">
                <div class="mac-dot red"></div><div class="mac-dot yellow"></div><div class="mac-dot green"></div>
                <span style="margin-left: 12px; font-size: 0.75rem; font-weight: 600; color: var(--wp-text-secondary); font-family: var(--font-mono);">SHELL@EQUENCE</span>
                <button id="metricsToggle" onclick="toggleMetrics()" style="margin-left: auto; background: none; border: none; color: var(--wp-text-secondary); cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;">
                  <i data-lucide="chevron-right" width="14" height="14" style="transition: transform 0.3s;"></i> Stats Panel
                </button>
              </div>
              <div class="terminal-body"><div id="terminal"></div></div>
              <div class="overlay" id="loadingOverlay">
                <div class="spinner"></div><div style="margin-top: 16px;">Connecting...</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar: Metrics -->
        <div class="metrics-ribbon" id="metricsRibbon">
          <div class="metric-card">
            <div class="metric-label"><i data-lucide="database" width="14" height="14"></i> Memory Usage</div>
            <div class="metric-grid" id="metricMem">--</div>
          </div>
          <div class="metric-card">
            <div class="metric-label"><i data-lucide="cpu" width="14" height="14"></i> System Load</div>
            <div class="metric-grid" id="metricTop">--</div>
          </div>
          <div class="metric-card" style="flex: 1; display: flex; flex-direction: column;">
            <div class="metric-label" style="margin-bottom: 12px;"><i data-lucide="line-chart" width="14" height="14"></i> Live Metrics</div>
            <div style="flex: 1; position: relative; min-height: 120px;">
              <canvas id="metricsChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();

    let currentUserGroup = '';
    let inviteTokenParam = new URLSearchParams(window.location.search).get('invite');

    // Startup flow
    if (inviteTokenParam) {
      validateInvite();
    } else {
      checkAuth();
    }

    function getGreeting(username) {
      const hour = new Date().getHours();
      if (hour < 12) return `Good morning, ${username}!`;
      if (hour < 18) return `Good afternoon, ${username}!`;
      return `Good evening, ${username}!`;
    }

    async function checkAuth() {
      try {
        const res = await fetch('/api/me');
        if (res.ok) {
          const user = await res.json();
          currentUserGroup = user.group;
          document.getElementById('userInfo').innerText = getGreeting(user.username);
          if (user.group === 'ITinfra') document.getElementById('adminBtn').style.display = 'flex';
          
          document.getElementById('loginModal').style.display = 'none';
          document.getElementById('app-container').classList.add('visible');
          loadServers();
        } else {
          document.getElementById('loginModal').style.display = 'flex';
        }
      } catch (e) {
        document.getElementById('loginModal').style.display = 'flex';
      }
    }

    async function doLogin() {
      const u = document.getElementById('loginUsername').value;
      const p = document.getElementById('loginPassword').value;
      const err = document.getElementById('loginError');
      try {
        const res = await fetch('/api/login', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({username: u, password: p})
        });
        if (res.ok) {
          err.innerText = '';
          window.location.reload();
        } else {
          const data = await res.json();
          err.innerText = data.error || 'Login failed';
        }
      } catch (e) { err.innerText = 'Network error'; }
    }

    async function logout() {
      await fetch('/api/logout', { method: 'POST' });
      window.location.reload();
    }

    async function validateInvite() {
      try {
        const res = await fetch('/api/invite/validate', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({token: inviteTokenParam})
        });
        if (res.ok) {
          const data = await res.json();
          document.getElementById('inviteUsername').innerText = data.username;
          document.getElementById('inviteModal').style.display = 'flex';
        } else {
          alert('Invite link is invalid or expired.');
          window.location.href = '/';
        }
      } catch (e) { alert('Error validating invite'); }
    }

    async function acceptInvite() {
      const p = document.getElementById('invitePassword').value;
      const err = document.getElementById('inviteError');
      try {
        const res = await fetch('/api/invite/accept', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({token: inviteTokenParam, password: p})
        });
        if (res.ok) {
          alert('Account created! Please login.');
          window.location.href = '/';
        } else {
          const data = await res.json();
          err.innerText = data.error || 'Failed to set password';
        }
      } catch (e) { err.innerText = 'Network error'; }
    }

    async function openAdminPanel() {
      document.getElementById('adminModal').style.display = 'flex';
      loadUsers();
    }

    async function loadUsers() {
      const res = await fetch('/api/users');
      if (res.ok) {
        const users = await res.json();
        const tbody = document.getElementById('usersTableBody');
        tbody.innerHTML = '';
        users.forEach(u => {
          tbody.innerHTML += `
            <tr>
              <td style="font-weight:600;">${u.username}</td>
              <td>${u.group}</td>
              <td><span class="status-pill ${u.enabled ? 'active' : 'disabled'}">${u.enabled ? 'Active' : 'Disabled'}</span></td>
              <td>${u.assignedServers.join(', ') || 'All/None'}</td>
              <td style="display:flex; gap: 8px;">
                <button class="btn-action" onclick="toggleUser('${u.id}', ${!u.enabled})">${u.enabled ? 'Disable' : 'Enable'}</button>
                <button class="btn-action" onclick="regenInvite('${u.id}')">Invite Link</button>
                ${u.username !== 'ITinfra' ? `<button class="btn-action" style="border-color: rgba(239, 68, 68, 0.3); color: #ef4444;" onclick="deleteUser('${u.id}')">Delete</button>` : ''}
              </td>
            </tr>
          `;
        });
      }
    }

    async function deleteUser(id) {
      if (!confirm('Are you sure you want to delete this user?')) return;
      try {
        const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        if (res.ok) {
          loadUsers();
        } else {
          const data = await res.json();
          alert(data.error || 'Failed to delete user');
        }
      } catch (e) { alert('Network error'); }
    }

    async function createUser() {
      const u = document.getElementById('newUsername').value;
      const g = document.getElementById('newGroup').value;
      const s = document.getElementById('newServers').value.split(',').map(x=>x.trim()).filter(x=>x);
      const err = document.getElementById('adminError');
      const succ = document.getElementById('adminSuccess');
      
      try {
        const res = await fetch('/api/users', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({username: u, group: g, assignedServers: s})
        });
        const data = await res.json();
        if (res.ok) {
          err.innerText = '';
          succ.innerHTML = `Invite Link: <a href="${window.location.origin}${data.inviteLink}" target="_blank">${window.location.origin}${data.inviteLink}</a>`;
          loadUsers();
        } else {
          succ.innerText = '';
          err.innerText = data.error || 'Failed to create user';
        }
      } catch (e) { err.innerText = 'Network error'; }
    }

    async function toggleUser(id, enable) {
      await fetch(`/api/users/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({enabled: enable}) });
      loadUsers();
    }

    async function regenInvite(id) {
      try {
        const res = await fetch(`/api/users/${id}/invite`, { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          document.getElementById('adminSuccess').innerText = `New Invite Link: ${window.location.origin}${data.inviteLink}`;
        } else {
          alert(data.error || 'Failed to regenerate invite');
        }
      } catch (e) {
        alert('Network error');
      }
    }

    // --- LOG BROWSER LOGIC ---
    let discoveredLogs = [];
    function openLogBrowser() {
      document.getElementById('logBrowserModal').style.display = 'flex';
      renderLogBrowser();
    }
    
    function renderLogBrowser(filter) {
      const list = document.getElementById('logBrowserList');
      list.innerHTML = '';
      const termLower = (filter || '').toLowerCase();
      
      const filtered = discoveredLogs.filter(f => f.toLowerCase().includes(termLower)).slice(0, 200);
      
      if (filtered.length === 0) {
        list.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);">No logs discovered yet. Connect to a server first.</div>';
        return;
      }
      
      filtered.forEach(file => {
        const div = document.createElement('div');
        div.style.cssText = 'padding:10px 16px; border-bottom:1px solid rgba(255,255,255,0.05); cursor:pointer; display:flex; align-items:center; gap:10px; font-family:var(--font-mono); font-size:0.85rem; transition: background 0.15s;';
        div.onmouseover = () => { div.style.background = 'rgba(255,255,255,0.05)'; };
        div.onmouseout = () => { div.style.background = 'transparent'; };
        div.innerHTML = '<i data-lucide="file-text" width="16" height="16" style="color: var(--accent); flex-shrink:0;"></i> <span style="word-break: break-all;">' + file + '</span>';
        div.onclick = () => {
          document.getElementById('logPathInput').value = file;
          document.getElementById('logBrowserModal').style.display = 'none';
          executeMacro('tail');
        };
        list.appendChild(div);
      });
      if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
    }
    
    document.getElementById('logSearchInput').addEventListener('input', (e) => {
      renderLogBrowser(e.target.value);
    });

    // --- METRICS HELPERS ---
    function toggleMetrics() {
      const ribbon = document.getElementById('metricsRibbon');
      const isHidden = !ribbon.classList.contains('show');
      const chev = document.querySelector('#metricsToggle i');

      if (isHidden) {
        ribbon.classList.add('show');
        if (!metricsChart && typeof Chart !== 'undefined') initChart();
        if (chev) chev.style.transform = 'rotate(180deg)';
      } else {
        ribbon.classList.remove('show');
        if (chev) chev.style.transform = 'rotate(0deg)';
      }
      setTimeout(() => fitAddon.fit(), 120);
    }

    /** Chart redraw at most ~1.2 Hz to avoid idle CPU when panel is open */
    let metricsChartFlushTimer = null;
    let pendingChartMem = null;
    let pendingChartCpu = null;
    function scheduleChartUpdate(memUsedGB, cpuPercent) {
      pendingChartMem = memUsedGB;
      pendingChartCpu = cpuPercent;
      if (metricsChartFlushTimer != null) return;
      metricsChartFlushTimer = setTimeout(() => {
        metricsChartFlushTimer = null;
        const ribbon = document.getElementById('metricsRibbon');
        if (!ribbon.classList.contains('show') || !metricsChart) return;
        updateChart(pendingChartMem, pendingChartCpu);
      }, 850);
    }

    function parseAndDisplayMetrics(data) {
      try {
        const parts = data.split('---');
        const memLines = (parts[0]||'').split('\n');
        const memLine = memLines.find(l => /^Mem:/i.test(l.trim()));
        let usedGBForChart = 0;

        if (memLine) {
          const nums = memLine.trim().replace(/^Mem:/i, '').trim().split(/\s+/).map(n => parseInt(n));
          const totalMB = nums[0] || 0;
          const usedMB = nums[1] || 0;
          const availableMB = nums[5] || nums[2] || 0;

          const totalGB = totalMB / 1024;
          const usedGB = usedMB / 1024;
          const availableGB = availableMB / 1024;
          usedGBForChart = totalMB > 0 ? usedGB : 0;
          const loadPercent = totalGB > 0 ? (usedGB / totalGB) * 100 : 0;
          const loadColor = loadPercent >= 85 ? 'var(--accent-danger)' : (loadPercent >= 70 ? '#fbbf24' : 'var(--accent)');

          document.getElementById('metricMem').innerHTML = `
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 10px;">
              <div><span class="mk">Total</span><div class="mv" style="font-size:1.1rem">${totalGB.toFixed(1)} GB</div></div>
              <div><span class="mk">Used %</span><div class="mv" style="font-size:1.1rem; color:${loadColor}">${loadPercent.toFixed(0)}%</div></div>
              <div><span class="mk">Used</span><div class="mv" style="font-size:1.1rem">${usedGB.toFixed(2)} GB</div></div>
              <div><span class="mk">Avail</span><div class="mv" style="font-size:1.1rem">${availableGB.toFixed(2)} GB</div></div>
            </div>
          `;
        }

        const cpuLine = (parts[1]||'').split('\n').find(l => /^[%]?Cpu/i.test(l.trim()));
        let cpuUs = 0;
        if (cpuLine) {
          const usMatch = cpuLine.match(/([\d.]+)\s*us/);
          if (usMatch) cpuUs = parseFloat(usMatch[1]);
          document.getElementById('metricTop').innerHTML = `
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 10px;">
              <div><span class="mk">CPU</span><div class="mv" style="font-size:1.1rem">${cpuUs.toFixed(1)}%</div></div>
              <div><span class="mk">Idle</span><div class="mv" style="font-size:1.1rem">${(100 - cpuUs).toFixed(1)}%</div></div>
            </div>
          `;
          scheduleChartUpdate(usedGBForChart, cpuUs);
        }
      } catch(e) { console.error('Metric parsing error:', e); }
    }

    // --- CHART.JS LIVE METRICS ---
    let metricsChart = null;
    const chartLabels = [];
    const chartMemData = [];
    const chartCpuData = [];
    const MAX_CHART_POINTS = 20;

    function initChart() {
      const ctx = document.getElementById('metricsChart');
      if (!ctx) return;
      if (metricsChart) { metricsChart.destroy(); metricsChart = null; }
      chartLabels.length = 0; chartMemData.length = 0; chartCpuData.length = 0;
      metricsChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: chartLabels,
          datasets: [
            { label: 'Mem used (GB)', data: chartMemData, borderColor: '#0075FF', backgroundColor: 'rgba(0,117,255,0.08)', borderWidth: 2, pointRadius: 0, tension: 0.4, fill: true },
            { label: 'CPU %', data: chartCpuData, borderColor: '#21D4FD', backgroundColor: 'rgba(33,212,253,0.06)', borderWidth: 2, pointRadius: 0, tension: 0.4, fill: true }
          ]
        },
          options: {
          animation: false,
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'nearest', intersect: false },
          plugins: { legend: { display: false } },
          scales: {
            x: { display: false },
            y: { display: false, min: 0 }
          }
        }
      });
    }

    function updateChart(memUsedGB, cpuPercent) {
      if (!metricsChart) return;
      const now = new Date().toLocaleTimeString();
      chartLabels.push(now);
      chartMemData.push(parseFloat(memUsedGB) || 0);
      chartCpuData.push(parseFloat(cpuPercent) || 0);
      if (chartLabels.length > MAX_CHART_POINTS) {
        chartLabels.shift(); chartMemData.shift(); chartCpuData.shift();
      }
      metricsChart.update('none'); // no animation for performance
    }

    // --- SESSION TIMEOUT (15 min inactivity) ---
    const IDLE_TIMEOUT_MS = 15 * 60 * 1000;
    let idleTimer = null;
    function resetIdleTimer() {
      clearTimeout(idleTimer);
      idleTimer = setTimeout(async () => {
        if (ws && ws.readyState === WebSocket.OPEN) ws.close();
        await fetch('/api/logout', { method: 'POST' });
        document.getElementById('app-container').classList.remove('visible');
        document.getElementById('loginModal').style.display = 'flex';
        document.querySelector('#loginModal h2').textContent = '⚠️ Session Expired (15 min inactivity)';
      }, IDLE_TIMEOUT_MS);
    }
    document.addEventListener('mousemove', resetIdleTimer);
    document.addEventListener('keydown', resetIdleTimer);
    document.addEventListener('click', resetIdleTimer);

    // --- TERMINAL & CORE APP LOGIC ---
    let currentLogFile = '/var/log/messages';
    const term = new Terminal({
      cursorBlink: true, cursorStyle: 'block',
      theme: {
        background: '#060B26',
        foreground: '#E2E8F0',
        cursor: '#0075FF',
        cursorAccent: '#060B26',
        selectionBackground: 'rgba(0,117,255,0.3)',
        black: '#1B2559', red: '#E31A1A', green: '#01B574',
        yellow: '#FFB800', blue: '#0075FF', magenta: '#8247E5',
        cyan: '#00E396', white: '#E2E8F0',
        brightBlack: '#718096', brightRed: '#FF6B6B', brightGreen: '#01E08F',
        brightYellow: '#FFD600', brightBlue: '#58A6FF', brightMagenta: '#B794F4',
        brightCyan: '#00FAD9', brightWhite: '#fff',
      },
      fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
      fontSize: 14, lineHeight: 1.35,
      scrollback: 10000, scrollSensitivity: 1.5,
      letterSpacing: 0, allowTransparency: false,
    });
    window.term = term;
    const fitAddon = new FitAddon.FitAddon();
    const searchAddon = new SearchAddon.SearchAddon();
    term.loadAddon(fitAddon); term.loadAddon(searchAddon);
    try {
      const webglAddon = new WebglAddon.WebglAddon();
      term.loadAddon(webglAddon);
    } catch (e) {
      console.warn('WebGL addon failed to load, falling back to canvas', e);
    }
    
    term.open(document.getElementById('terminal'));
    let ws = null;

    /** Coalesce rapid WebSocket chunks into one paint per frame */
    let pendingTermOut = '';
    let termFlushRaf = null;
    function enqueueTermWrite(str) {
      pendingTermOut += str;
      if (termFlushRaf != null) return;
      termFlushRaf = requestAnimationFrame(() => {
        termFlushRaf = null;
        if (pendingTermOut.length) {
          term.write(pendingTermOut);
          pendingTermOut = '';
        }
      });
    }
    function flushTermNow() {
      if (termFlushRaf != null) cancelAnimationFrame(termFlushRaf);
      termFlushRaf = null;
      if (pendingTermOut.length) {
        term.write(pendingTermOut);
        pendingTermOut = '';
      }
    }

    // Debounced resize for smooth performance
    let resizeTimeout = null;
    function debouncedFit() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (document.getElementById('terminalWindow').style.display !== 'none') {
          fitAddon.fit();
          if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ action: 'resize', cols: term.cols, rows: term.rows }));
        }
      }, 120);
    }

    window.addEventListener('resize', debouncedFit);

    // ResizeObserver for reliable terminal sizing
    const terminalEl = document.getElementById('terminal');
    if (window.ResizeObserver) {
      new ResizeObserver(debouncedFit).observe(terminalEl);
    }

    term.onResize(size => {
      if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ action: 'resize', cols: size.cols, rows: size.rows }));
    });

    term.onData(data => {
      if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ action: 'input', data: data }));
    });

    function loadServers() {
      fetch('/servers')
        .then(res => res.json())
        .then(servers => {
          const list = document.getElementById('serverList');
          list.innerHTML = '';
          const groups = servers.reduce((acc, server) => {
            let g = server.group || 'OTHER';
            if (!acc[g]) acc[g] = [];
            acc[g].push(server);
            return acc;
          }, {});

          Object.keys(groups).sort().forEach(groupName => {
            const srvs = groups[groupName];
            const groupDiv = document.createElement('div');
            groupDiv.className = 'server-group';
            groupDiv.innerHTML = `<div class="server-group-header" onclick="this.parentElement.classList.toggle('open')"><i data-lucide="folder" class="folder-icon" width="16" height="16"></i>${groupName}<i data-lucide="chevron-right" class="chevron-icon" width="16" height="16"></i></div><div class="server-group-content"></div>`;
            const contentDiv = groupDiv.querySelector('.server-group-content');

            srvs.forEach(s => {
              const item = document.createElement('div');
              item.className = `server-item ${s.enabled ? '' : 'disabled'}`;
              item.innerHTML = `<div class="server-info"><span class="server-name">${s.id}</span><span class="server-ip">${s.host}</span></div><div class="status-indicator"></div>`;
              if (s.enabled) {
                item.onclick = (e) => { e.stopPropagation(); connectToServer(s.id, item, s); };
              }
              contentDiv.appendChild(item);
            });
            list.appendChild(groupDiv);
          });

          // Populate the Admin Group dropdown with unique groups
          const groupSelect = document.getElementById('newGroup');
          if (groupSelect) {
            const currentGroups = Object.keys(groups).sort();
            groupSelect.innerHTML = currentGroups.map(g => `<option value="${g}">${g}</option>`).join('') + '<option value="ITinfra">ITinfra (Admin)</option>';
          }

          if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
        });
    }

    function connectToServer(serverId, element, serverData) {
      document.querySelectorAll('.server-item').forEach(el => el.classList.remove('active'));
      element.classList.add('active');
      
      discoveredLogs = [];
      document.getElementById('logPathInput').value = '/var/log/messages';

      const emptyState = document.getElementById('emptyState');
      const termWindow = document.getElementById('terminalWindow');
      
      emptyState.style.display = 'none';
      termWindow.style.display = 'flex';
      termWindow.style.opacity = '1';
      termWindow.style.transform = 'none';

      document.getElementById('topbarEmpty').style.display = 'none';
      document.getElementById('topbarInfo').style.display = 'flex';
      document.getElementById('serverTitle').innerText = `${serverData.group} / ${serverData.id}`;
      document.getElementById('serverIp').innerText = serverData.host;
      document.getElementById('metricsRibbon').classList.remove('show');
      const mt = document.querySelector('#metricsToggle i');
      if (mt) mt.style.transform = 'rotate(0deg)';
      if (metricsChart) { metricsChart.destroy(); metricsChart = null; }
      document.getElementById('logActions').style.display = 'flex';
      
      if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();

      if (ws) ws.close();
      flushTermNow();
      term.clear();
      document.getElementById('loadingOverlay').classList.add('active');

      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      ws = new WebSocket(`${protocol}//${window.location.host}`);
      
      ws.onopen = () => {
        ws.send(JSON.stringify({ action: 'connect', serverId }));
      };

      ws.onmessage = (event) => {
        let msg;
        try {
          msg = JSON.parse(event.data);
        } catch (parseErr) {
          console.warn('Malformed WebSocket message', parseErr);
          return;
        }
        switch (msg.type) {
          case 'connected':
            document.getElementById('loadingOverlay').classList.remove('active');
            resetIdleTimer();
            term.focus();
            setTimeout(() => fitAddon.fit(), 80);
            break;
          case 'log_catalog':
            try {
              const catalog = msg.data || {};
              discoveredLogs = Array.isArray(catalog.files) ? catalog.files : [];
              const services = Array.isArray(catalog.services) ? catalog.services : [];
              
              const journalServicesList = document.getElementById('journalServices');
              if (journalServicesList) {
                journalServicesList.innerHTML = '';
                services.slice(0, 400).forEach(s => {
                  const opt = document.createElement('option');
                  opt.value = s;
                  journalServicesList.appendChild(opt);
                });
              }

              if (discoveredLogs.length > 0) {
                document.getElementById('logPathInput').value = discoveredLogs[0];
              }
            } catch (e) {}
            break;
          case 'metrics':
            parseAndDisplayMetrics(msg.data);
            break;
          case 'output':
            enqueueTermWrite(msg.data);
            break;
          case 'error':
            document.getElementById('loadingOverlay').classList.remove('active');
            flushTermNow();
            term.write(`\r\n\x1b[38;2;239;68;68m[Error]: ${msg.data}\x1b[0m\r\n`);
            break;
          case 'disconnected':
            flushTermNow();
            term.write(`\r\n\x1b[38;2;245;158;11m[System]: ${msg.data}\x1b[0m\r\n`);
            break;
        }
      };

      ws.onclose = () => {
        document.getElementById('loadingOverlay').classList.remove('active');
        flushTermNow();
        term.write('\r\n\x1b[38;2;239;68;68m[System]: Connection closed.\x1b[0m\r\n');
      };
    }

    function executeMacro(type) {
      if (!ws || ws.readyState !== WebSocket.OPEN) return;
      
      if (type === 'clear') {
        term.clear();
        return;
      }
      
      ws.send(JSON.stringify({ action: 'input', data: '\x03' }));
      
      setTimeout(() => {
        let cmd = '';
        const path = document.getElementById('logPathInput').value || '/var/log/messages';
        const grepTerm = document.getElementById('liveGrepInput').value.trim();
        const grepSuffix = grepTerm ? ` | grep --line-buffered -i "${grepTerm}"` : '';
        
        if (type === 'tail') {
          cmd = `sudo tail -n 100 -f ${path}${grepSuffix}\r`;
        } else if (type === 'grep') {
          if (!grepTerm) { term.write('\r\n\x1b[38;2;245;158;11m[System]: Please enter a search term in the Grep box first.\x1b[0m\r\n'); return; }
          cmd = `sudo grep -i "${grepTerm}" ${path} | tail -n 20\r`;
        } else if (type === 'error') {
          cmd = `sudo grep -i "error" ${path} | tail -n 20\r`;
        } else if (type === 'exception') {
          cmd = `sudo grep -i "exception" ${path} | tail -n 20\r`;
        } else if (type === 'journal') {
          const svc = document.getElementById('journalServiceInput').value;
          if (!svc) { term.write('\r\n\x1b[38;2;245;158;11m[System]: Please enter a service name first.\x1b[0m\r\n'); return; }
          cmd = `sudo journalctl -u ${svc} -n 100 -f${grepSuffix}\r`;
        }
        
        if (cmd) ws.send(JSON.stringify({ action: 'input', data: cmd }));
        term.focus();
      }, 300);
    }

    // Add Enter listener to Grep input
    document.getElementById('liveGrepInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') executeMacro('tail');
    });

    // Search Addon Logic
    const searchInput = document.getElementById('searchInput');
    function executeSearch(reverse = false) {
      const val = searchInput.value;
      if (val) {
        if (! (reverse ? searchAddon.findPrevious(val) : searchAddon.findNext(val))) {
          searchInput.style.color = '#ef4444'; setTimeout(() => { searchInput.style.color = '#fff'; }, 1000);
        }
      }
    }
    searchInput.addEventListener('input', (e) => { if (!e.target.value) searchAddon.clearDecorations(); });
    searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') executeSearch(e.shiftKey); });
    document.getElementById('searchBtnNext').addEventListener('click', () => executeSearch(false));
    document.getElementById('searchBtnPrev').addEventListener('click', () => executeSearch(true));


    // --- THEME TOGGLE LOGIC ---
    function initTheme() {
      const saved = localStorage.getItem('theme');
      if (saved === 'light') {
        document.body.classList.add('light-mode');
        updateThemeUI(true);
      } else {
        updateThemeUI(false);
      }
    }

    function toggleTheme() {
      try {
        const isLight = document.body.classList.toggle('light-mode');
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
        updateThemeUI(isLight);
      } catch (err) { console.error(err); }
    }

    function applyXtermTheme(isLight) {
      if (!window.term) return;
      if (isLight) {
        window.term.options.theme = {
          background: '#ffffff', foreground: '#24292f', cursor: '#0f766e',
          selectionBackground: 'rgba(13, 148, 136, 0.25)',
          black: '#24292f', red: '#cf222e', green: '#116329',
          yellow: '#4d2d00', blue: '#0550ae', magenta: '#8250df',
          cyan: '#1b7c83', white: '#6e7781',
          brightBlack: '#57606a', brightRed: '#a40e26', brightGreen: '#1a7f37',
          brightYellow: '#633c01', brightBlue: '#0969da', brightMagenta: '#6639ba',
          brightCyan: '#1b7c83', brightWhite: '#8c959f',
        };
      } else {
        window.term.options.theme = {
          background: '#060B26', foreground: '#E2E8F0', cursor: '#0075FF',
          cursorAccent: '#060B26', selectionBackground: 'rgba(0,117,255,0.3)',
          black: '#1B2559', red: '#E31A1A', green: '#01B574',
          yellow: '#FFB800', blue: '#0075FF', magenta: '#8247E5',
          cyan: '#00E396', white: '#E2E8F0',
          brightBlack: '#718096', brightRed: '#FF6B6B', brightGreen: '#01E08F',
          brightYellow: '#FFD600', brightBlue: '#58A6FF', brightMagenta: '#B794F4',
          brightCyan: '#00FAD9', brightWhite: '#fff',
        };
      }
      try {
        window.term.refresh(0, Math.max(0, window.term.rows - 1));
      } catch (e) { /* ignore */ }
    }

    function updateThemeUI(isLight) {
      const wrap = document.getElementById('themeIconWrap');
      if (isLight) {
        wrap.innerHTML = '<i data-lucide="moon" width="16" height="16"></i>';
      } else {
        wrap.innerHTML = '<i data-lucide="sun" width="16" height="16"></i>';
      }
      applyXtermTheme(isLight);
      if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
    }

    initTheme();

    function openFind() {
      try {
        const overlay = document.getElementById('searchOverlay');
        overlay.style.display = 'flex';
        document.getElementById('searchInput').focus();
      } catch (err) { console.error(err); }
    }

    async function openDownloadModal() {
      const modal = document.getElementById('downloadModal');
      const select = document.getElementById('downloadServerSelect');
      modal.style.display = 'flex';
      
      // Reset view
      document.getElementById('downloadFileListContainer').style.display = 'none';
      document.getElementById('downloadBtn').style.display = 'none';
      document.getElementById('searchLogsBtn').style.display = 'block';
      document.getElementById('downloadStatus').innerText = '';
      
      // Populate server list
      try {
        const res = await fetch('/servers');
        const servers = await res.json();
        select.innerHTML = servers.map(s => `<option value="${s.id}">${s.group} / ${s.id}</option>`).join('');
      } catch (e) { console.error('Failed to load servers for download', e); }
      
      // Set default date range to today
      const today = new Date();
      document.getElementById('downloadStartDate').valueAsDate = today;
      document.getElementById('downloadEndDate').valueAsDate = today;
    }

    async function searchLogsForDownload() {
      const serverId = document.getElementById('downloadServerSelect').value;
      const startDate = document.getElementById('downloadStartDate').value;
      const endDate = document.getElementById('downloadEndDate').value;
      const path = document.getElementById('downloadPath').value || '/var/log';
      const btn = document.getElementById('searchLogsBtn');
      const status = document.getElementById('downloadStatus');
      const list = document.getElementById('downloadFileList');
      const listContainer = document.getElementById('downloadFileListContainer');
      const downloadBtn = document.getElementById('downloadBtn');
      
      if (!startDate || !endDate) { alert('Please select both start and end dates'); return; }
      
      btn.disabled = true;
      btn.innerText = 'Searching...';
      status.style.color = 'var(--wp-text-secondary)';
      status.innerText = `Scanning range ${startDate} to ${endDate}...`;
      list.innerHTML = '';
      
      try {
        const res = await fetch(`/api/list-logs-by-date?serverId=${serverId}&startDate=${startDate}&endDate=${endDate}&path=${encodeURIComponent(path)}`);
        const data = await res.json();
        
        if (res.ok && data.files && data.files.length > 0) {
          status.innerText = `Found ${data.files.length} matching files.`;
          status.style.color = 'var(--wp-text-primary)';
          listContainer.style.display = 'block';
          downloadBtn.style.display = 'block';
          btn.style.display = 'none';
          
          data.files.forEach(file => {
            const div = document.createElement('label');
            div.style.cssText = 'display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 0.85rem; padding: 4px 8px; border-radius: 6px; transition: background 0.2s;';
            div.onmouseover = () => div.style.background = 'rgba(255,255,255,0.05)';
            div.onmouseout = () => div.style.background = 'transparent';
            div.innerHTML = `<input type="checkbox" class="log-check" value="${file}" onchange="updateDownloadBtnCount()"> <span style="word-break: break-all;">${file}</span>`;
            list.appendChild(div);
          });
          updateDownloadBtnCount();
        } else {
          status.style.color = '#ef4444';
          status.innerText = data.error || 'No matching logs found for this date.';
        }
      } catch (e) {
        status.style.color = '#ef4444';
        status.innerText = 'Error connecting to server.';
      } finally {
        btn.disabled = false;
        btn.innerText = 'Search Logs';
      }
    }

    function updateDownloadBtnCount() {
      const count = document.querySelectorAll('.log-check:checked').length;
      const btn = document.getElementById('downloadBtn');
      btn.innerText = `Download Selected (${count})`;
      btn.disabled = count === 0;
      btn.style.opacity = count === 0 ? '0.5' : '1';
    }

    function toggleAllLogs(checked) {
      document.querySelectorAll('.log-check').forEach(cb => cb.checked = checked);
      updateDownloadBtnCount();
    }

    async function doDownload() {
      const serverId = document.getElementById('downloadServerSelect').value;
      const startDate = document.getElementById('downloadStartDate').value;
      const endDate = document.getElementById('downloadEndDate').value;
      const selectedFiles = Array.from(document.querySelectorAll('.log-check:checked')).map(cb => cb.value);
      const btn = document.getElementById('downloadBtn');
      const status = document.getElementById('downloadStatus');
      
      if (selectedFiles.length === 0) return;
      
      btn.disabled = true;
      btn.innerText = 'Filtering & Archiving...';
      status.style.color = 'var(--wp-text-secondary)';
      status.innerText = 'Filtering log content by date on remote server...';
      
      try {
        const res = await fetch('/api/download-logs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ serverId, files: selectedFiles, startDate, endDate })
        });
        
        if (res.ok) {
          status.style.color = '#10b981';
          status.innerText = 'Success! Download started.';
          const blob = await res.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `logs_${serverId}_${startDate}_to_${endDate}.tar.gz`;
          document.body.appendChild(a);
          a.click();
          a.remove();
        } else {
          const data = await res.json();
          status.style.color = '#ef4444';
          status.innerText = data.error || 'Failed to generate archive.';
        }
      } catch (e) {
        status.style.color = '#ef4444';
        status.innerText = 'Error during download.';
      } finally {
        btn.disabled = false;
        updateDownloadBtnCount();
      }
    }
  </script>
</body>
</html>
